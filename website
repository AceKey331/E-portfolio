<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Bhavesh Bhagat — EXTC Engineer &amp; VLSI Enthusiast</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0C1526;
    --bg-2: #0A111F;
    --surface: #121F38;
    --surface-2: #1A2B4A;
    --line: #24365A;
    --copper: #C97C45;
    --copper-bright: #E39A63;
    --patina: #6FAFA0;
    --text: #EAF0FA;
    --text-mid: #B4C0D9;
    --text-muted: #7C8AAA;
    --radius: 3px;
    --display: 'Space Grotesk', sans-serif;
    --body: 'Inter', sans-serif;
    --mono: 'IBM Plex Mono', monospace;
  }

  *{ box-sizing: border-box; margin:0; padding:0; }
  html{ scroll-behavior: smooth; }

  body{
    background: var(--bg);
    color: var(--text);
    font-family: var(--body);
    line-height: 1.6;
    overflow-x: hidden;
    background-image:
      radial-gradient(circle at 1px 1px, rgba(201,124,69,0.07) 1px, transparent 0);
    background-size: 28px 28px;
  }

  ::selection{ background: var(--copper); color: #0C1526; }

  a{ color: inherit; text-decoration: none; }

  .container{
    max-width: 920px;
    margin: 0 auto;
    padding: 0 32px;
  }

  /* ---------- NAV RAIL ---------- */
  .rail{
    position: fixed;
    top: 0; left: 0;
    height: 100vh;
    width: 84px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 50;
    border-right: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(12,21,38,0.4), rgba(12,21,38,0.9));
    backdrop-filter: blur(4px);
  }
  .rail-trace{
    position: absolute;
    top: 0; bottom: 0; left: 50%;
    width: 2px;
    transform: translateX(-50%);
    background: linear-gradient(180deg, transparent, var(--line) 8%, var(--line) 92%, transparent);
  }
  .rail-trace-fill{
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 0%;
    background: linear-gradient(180deg, var(--copper), var(--patina));
    transition: height 0.15s linear;
  }
  .rail-pins{
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 34px;
    z-index: 2;
  }
  .rail-pin{
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    cursor: pointer;
    background: none; border: none;
    color: var(--text-muted);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
  }
  .rail-pin .dot{
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--bg-2);
    border: 2px solid var(--line);
    transition: all 0.25s ease;
  }
  .rail-pin.active .dot{
    background: var(--copper);
    border-color: var(--copper-bright);
    box-shadow: 0 0 10px rgba(201,124,69,0.7);
  }
  .rail-pin.active{ color: var(--copper-bright); }
  .rail-pin:hover .dot{ border-color: var(--patina); }

  .rail-brand{
    position: absolute;
    top: 28px; left: 0; right:0;
    display: flex;
    justify-content: center;
    font-family: var(--mono);
    font-size: 9px;
    color: var(--text-muted);
    letter-spacing: 0.15em;
  }

  @media (max-width: 820px){
    .rail{
      width: 100%; height: 56px;
      top: 0; left: 0;
      flex-direction: row;
      border-right: none;
      border-bottom: 1px solid var(--line);
      overflow-x: auto;
    }
    .rail-trace{ display:none; }
    .rail-brand{ display: none; }
    .rail-pins{ flex-direction: row; gap: 22px; padding: 0 18px; }
    body{ padding-top: 56px; }
  }

  main{ margin-left: 84px; }
  @media (max-width: 820px){ main{ margin-left: 0; } }

  section{ padding: 120px 0; position: relative; }
  section:first-of-type{ padding-top: 90px; }

  .eyebrow{
    font-family: var(--mono);
    font-size: 12px;
    color: var(--copper-bright);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
  }
  .eyebrow::before{
    content: '';
    width: 22px; height: 1px;
    background: var(--copper);
  }

  h1,h2,h3{ font-family: var(--display); font-weight: 600; letter-spacing: -0.01em; }

  /* ---------- HERO ---------- */
  .hero{
    min-height: 92vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 60px;
    padding-bottom: 60px;
  }
  .hero-top{
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (max-width: 820px){ .hero-top{ grid-template-columns: 1fr; } }

  .hero h1{
    font-size: clamp(2.6rem, 6vw, 4.4rem);
    line-height: 1.02;
    color: var(--text);
  }
  .hero h1 span{ color: var(--copper-bright); }

  .hero-headline{
    margin-top: 22px;
    font-size: 1.05rem;
    color: var(--text-mid);
    max-width: 46ch;
  }

  .hero-meta{
    margin-top: 26px;
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--text-muted);
  }
  .hero-meta span{ display:flex; align-items:center; gap:7px; }
  .hero-meta .dot{ width:6px; height:6px; border-radius:50%; background: var(--patina); }

  .hero-actions{ margin-top: 34px; display:flex; gap: 14px; flex-wrap: wrap; }
  .btn{
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.04em;
    padding: 13px 22px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    transition: all 0.2s ease;
    display: inline-flex; align-items:center; gap: 8px;
  }
  .btn-primary{
    background: var(--copper);
    color: #0C1522;
    border-color: var(--copper);
    font-weight: 600;
  }
  .btn-primary:hover{ background: var(--copper-bright); box-shadow: 0 0 24px rgba(201,124,69,0.35); }
  .btn-ghost{ color: var(--text-mid); }
  .btn-ghost:hover{ border-color: var(--patina); color: var(--patina); }

  /* IC chip signature graphic */
  .chip-wrap{ display:flex; justify-content:center; align-items:center; }
  .chip-svg{ width: 100%; max-width: 340px; height:auto; }
  .chip-body-rect{ fill: var(--surface); stroke: var(--line); stroke-width: 1.5; }
  .chip-notch{ fill: var(--bg); }
  .chip-pin{ stroke: var(--copper); stroke-width: 2; }
  .chip-pin-draw{
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: draw-pin 1s ease forwards;
  }
  @keyframes draw-pin{ to{ stroke-dashoffset: 0; } }
  .chip-label{
    font-family: var(--mono);
    font-size: 8.4px;
    fill: var(--text-mid);
    letter-spacing: 0.02em;
  }
  .chip-title{
    font-family: var(--mono);
    font-size: 11px;
    fill: var(--copper-bright);
    letter-spacing: 0.05em;
  }
  .chip-sub{ font-family: var(--mono); font-size: 8px; fill: var(--text-muted); }

  /* ---------- DATASHEET / ABOUT ---------- */
  .datasheet{
    position: relative;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 40px;
  }
  .datasheet::before, .datasheet::after,
  .ds-corner-tl, .ds-corner-br{ content:''; }
  .corner{
    position: absolute; width: 14px; height: 14px;
    border-color: var(--copper);
    border-style: solid;
    opacity: 0.9;
  }
  .corner.tl{ top:-1px; left:-1px; border-width: 2px 0 0 2px; }
  .corner.br{ bottom:-1px; right:-1px; border-width: 0 2px 2px 0; }

  .ds-header{
    display:flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
    font-family: var(--mono); font-size: 11px; color: var(--text-muted);
    border-bottom: 1px dashed var(--line);
    padding-bottom: 16px;
    margin-bottom: 22px;
    letter-spacing: 0.04em;
  }
  .ds-header b{ color: var(--patina); font-weight: 500; }

  .about-quote{
    font-family: var(--display);
    font-size: 1.35rem;
    color: var(--text);
    line-height: 1.5;
    font-weight: 500;
  }
  .about-quote .mark{ color: var(--copper-bright); }

  .stat-row{
    margin-top: 34px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
  }
  .stat{
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 16px 18px;
    background: var(--bg-2);
  }
  .stat .num{ font-family: var(--display); font-size: 1.7rem; color: var(--copper-bright); font-weight: 700; }
  .stat .lbl{ font-family: var(--mono); font-size: 10.5px; color: var(--text-muted); margin-top: 4px; letter-spacing: 0.04em; }

  /* ---------- SECTION HEADS ---------- */
  .sec-head{ margin-bottom: 48px; }
  .sec-head h2{ font-size: clamp(1.8rem, 3.4vw, 2.4rem); color: var(--text); }
  .sec-head p{ color: var(--text-muted); margin-top: 10px; max-width: 56ch; }

  /* ---------- EDUCATION TIMELINE ---------- */
  .timeline{ position: relative; padding-left: 34px; }
  .timeline::before{
    content:'';
    position:absolute; left: 5px; top: 6px; bottom: 6px;
    width: 2px;
    background: linear-gradient(180deg, var(--copper), var(--patina) 60%, transparent);
  }
  .tl-item{ position: relative; padding-bottom: 42px; }
  .tl-item:last-child{ padding-bottom: 0; }
  .tl-via{
    position: absolute; left: -34px; top: 4px;
    width: 12px; height: 12px; border-radius: 50%;
    background: var(--bg); border: 2px solid var(--copper);
    box-shadow: 0 0 0 4px var(--bg-2);
  }
  .tl-date{ font-family: var(--mono); font-size: 11px; color: var(--patina); letter-spacing: 0.04em; }
  .tl-item h3{ font-size: 1.2rem; margin-top: 6px; color: var(--text); }
  .tl-item .degree{ color: var(--copper-bright); font-size: 0.92rem; margin-top: 3px; font-family: var(--mono); }
  .tl-item p.notes{ color: var(--text-mid); margin-top: 10px; font-size: 0.94rem; max-width: 60ch; }

  /* ---------- SKILLS ---------- */
  .skill-groups{ display: grid; gap: 30px; }
  .skill-group-label{
    font-family: var(--mono); font-size: 11px; color: var(--text-muted);
    letter-spacing: 0.08em; margin-bottom: 12px; display:flex; align-items:center; gap:8px;
  }
  .skill-group-label::before{ content:'▸'; color: var(--copper); }
  .chip-row{ display:flex; flex-wrap: wrap; gap: 9px; }
  .chip{
    font-family: var(--mono);
    font-size: 12px;
    padding: 8px 14px;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    color: var(--text-mid);
    background: var(--surface);
    transition: all 0.2s ease;
    position: relative;
  }
  .chip::before{
    content:''; position:absolute; left: -1px; top:50%; transform: translateY(-50%);
    width: 5px; height: 1.5px; background: var(--line);
  }
  .chip:hover{ border-color: var(--patina); color: var(--patina); transform: translateY(-2px); }

  /* ---------- PROJECTS ---------- */
  .projects{ display: grid; gap: 22px; }
  .pcard{
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 30px;
    position: relative;
    overflow: hidden;
  }
  .pcard::before{
    content:''; position:absolute; top:0; left:0; right:0; height: 3px;
    background: repeating-linear-gradient(90deg, var(--copper) 0 8px, transparent 8px 16px);
    opacity: 0.7;
  }
  .pcard-top{ display:flex; justify-content: space-between; align-items:flex-start; gap: 16px; flex-wrap: wrap; }
  .pcard h3{ font-size: 1.25rem; color: var(--text); }
  .pcard .date{ font-family: var(--mono); font-size: 11px; color: var(--patina); white-space: nowrap; padding-top: 4px; }
  .pcard p{ margin-top: 14px; color: var(--text-mid); font-size: 0.95rem; max-width: 68ch; }
  .pcard .tag-row{ margin-top: 16px; display:flex; gap:8px; flex-wrap:wrap; }
  .pcard .tag{
    font-family: var(--mono); font-size: 10.5px; color: var(--text-muted);
    border: 1px solid var(--line); padding: 4px 10px; border-radius: 20px;
  }

  /* ---------- CERTIFICATIONS ---------- */
  .cert-featured{ display: grid; grid-template-columns: repeat(auto-fit, minmax(260px,1fr)); gap: 16px; margin-bottom: 40px; }
  .cert-card{
    border: 1px solid var(--line); border-radius: var(--radius);
    padding: 20px; background: var(--surface);
  }
  .cert-card h4{ font-family: var(--display); font-size: 1.02rem; color: var(--text); font-weight: 600; }
  .cert-card .auth{ font-family: var(--mono); font-size: 11px; color: var(--copper-bright); margin-top: 6px; }
  .cert-card .when{ font-family: var(--mono); font-size: 10.5px; color: var(--text-muted); margin-top: 10px; }

  .badge-label{ font-family: var(--mono); font-size: 11px; color: var(--text-muted); letter-spacing: 0.08em; margin-bottom: 14px; }
  .badge-grid{ display:flex; flex-wrap:wrap; gap: 9px; }
  .badge{
    font-family: var(--mono); font-size: 11px; color: var(--text-mid);
    border: 1px solid var(--line); background: var(--bg-2);
    padding: 7px 12px; border-radius: var(--radius);
    transition: all 0.2s ease;
  }
  .badge:hover{ border-color: var(--copper); color: var(--copper-bright); }

  /* ---------- LANGUAGES ---------- */
  .lang-grid{ display: grid; gap: 18px; max-width: 480px; }
  .lang-row{ display:flex; align-items:center; gap: 18px; }
  .lang-name{ font-family: var(--display); font-size: 1rem; width: 90px; flex-shrink:0; }
  .signal-bars{ display:flex; gap: 4px; align-items: flex-end; height: 22px; }
  .signal-bars i{ display:block; width: 7px; background: var(--line); border-radius: 1px; }
  .signal-bars i:nth-child(1){ height: 35%; }
  .signal-bars i:nth-child(2){ height: 55%; }
  .signal-bars i:nth-child(3){ height: 75%; }
  .signal-bars i:nth-child(4){ height: 100%; }
  .signal-bars.l3 i:nth-child(-n+3){ background: var(--patina); }
  .signal-bars.l4 i{ background: var(--copper); }
  .lang-prof{ font-family: var(--mono); font-size: 10.5px; color: var(--text-muted); }

  /* ---------- CONTACT / FOOTER ---------- */
  .contact{ text-align: center; padding-bottom: 80px; }
  .contact h2{ font-size: clamp(2rem, 5vw, 3rem); }
  .contact p{ color: var(--text-muted); margin-top: 14px; max-width: 50ch; margin-left:auto; margin-right:auto; }
  .contact-actions{ margin-top: 34px; display:flex; gap: 14px; justify-content:center; flex-wrap:wrap; }

  footer{
    border-top: 1px solid var(--line);
    padding: 26px 0;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text-muted);
    display:flex; justify-content: space-between; flex-wrap: wrap; gap: 8px;
  }

  .reveal{ opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .reveal.in{ opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce){
    html{ scroll-behavior: auto; }
    .reveal{ opacity:1; transform:none; transition:none; }
    .chip-pin-draw{ animation: none; stroke-dashoffset: 0; }
  }

  :focus-visible{ outline: 2px solid var(--patina); outline-offset: 3px; }
</style>
</head>
