  <!-- EDUCATION -->
  <section id="education" class="container">
    <div class="reveal">
      <div class="eyebrow">02 · Signal Path</div>
      <div class="sec-head">
        <h2>Education</h2>
        <p>The path from school to semiconductor — traced start to present.</p>
      </div>
      <div class="timeline">

        <div class="tl-item">
          <span class="tl-via"></span>
          <div class="tl-date">JUL 2025 — NOV 2029 · CURRENT</div>
          <h3>Vidyalankar Institute of Technology, Mumbai</h3>
          <div class="degree">Bachelor of Technology — EXTC</div>
          <p class="notes">Focused on VLSI Design, Digital Electronics and Communication Systems. Active in football and baseball outside the lab.</p>
