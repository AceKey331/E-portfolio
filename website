<script>
  // Scroll reveal
  const revealEls = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { threshold: 0.15 });
  revealEls.forEach(el => io.observe(el));

  // Nav rail active state + trace fill
  const pins = document.querySelectorAll('.rail-pin');
  const sections = Array.from(pins).map(p => document.getElementById(p.dataset.target)).filter(Boolean);
  const railFill = document.getElementById('railFill');

  pins.forEach(pin => {
    pin.addEventListener('click', () => {
      const target = document.getElementById(pin.dataset.target);
      if(target) target.scrollIntoView({ behavior: 'smooth' });
    });
  });

  function onScroll(){
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? Math.min(100, (scrollTop / docHeight) * 100) : 0;
    if(railFill) railFill.style.height = pct + '%';

    let currentIndex = 0;
    sections.forEach((sec, i) => {
      if(sec && sec.getBoundingClientRect().top < window.innerHeight * 0.4) currentIndex = i;
    });
    pins.forEach((p, i) => p.classList.toggle('active', i === currentIndex));
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

